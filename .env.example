# =============================================================================
# TestimonialHub — environment variables (example)
# Copy to .env (or .env.local) and fill in real values.
# NEVER commit .env or any file containing real secrets.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development

# Base URL of the deployed app (used for Stripe redirect URLs and email links)
APP_URL=http://localhost:3000

# ---- Database (MySQL) -------------------------------------------------------
# Matches the locally-configured MySQL 8 instance and `testimonialhub` database.
# Replace the password with the value you set for `testimonialhub_app@localhost`.
DATABASE_URL="mysql://testimonialhub_app:CHANGE_ME@127.0.0.1:3306/testimonialhub"

# ---- Auth.js (NextAuth v5) --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
AUTH_URL=http://localhost:3000
# Trust the host header in development (NextAuth v5 requirement)
AUTH_TRUST_HOST=true

# ---- Stripe (TEST MODE only) ------------------------------------------------
# Get test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
# Webhook signing secret from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Price ID for the Paid plan (create in Stripe Dashboard test mode)
STRIPE_PAID_PRICE_ID=price_CHANGE_ME

# ---- Resend (transactional email) -------------------------------------------
# Get from https://resend.com/api-keys (free tier is fine for dev)
RESEND_API_KEY=re_CHANGE_ME
# Verified sender domain or `onboarding@resend.com` for dev
EMAIL_FROM="TestimonialHub <noreply@resound.dev>"
EMAIL_REPLY_TO=support@example.com

# ---- Public app config (exposed to the browser) -----------------------------
NEXT_PUBLIC_APP_NAME=TestimonialHub

# ---- Feature flags / toggles ------------------------------------------------
# Disable CAPTCHA verification in local dev if a key is not configured
CAPTCHA_ENABLED=false
# hCaptcha site + secret (only required if CAPTCHA_ENABLED=true)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
